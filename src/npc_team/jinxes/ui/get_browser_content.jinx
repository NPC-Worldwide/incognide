jinx_name: get_browser_content
description: Return the cleaned full HTML and interactive element summary for a browser pane. Use this to understand the current page before typing/clicking.
permissions:
  default: allow
inputs:
  - paneId:
      type: string
      description: The ID of the browser pane (omit for active)
      required: false
  - maxChars:
      type: integer
      description: Maximum characters of HTML to return (default 100000)
      required: false
  - includeInteractive:
      type: boolean
      description: Whether to include a summary of interactive elements (default true)
      required: false
steps:
  - name: get_browser_content
    engine: incognide
    action: get_browser_content
    args:
      paneId: "{{ paneId | default('active') }}"
      maxChars: "{{ maxChars | default(100000) }}"
      includeInteractive: "{{ includeInteractive | default(true) }}"
